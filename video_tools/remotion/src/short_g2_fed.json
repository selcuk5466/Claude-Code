   "text": "faizi %5,13'le 3 haftanın"
  },
  {
   "start": 29.84,
   "end": 30.95,
   "text": "zirvesini gördü."
  },
  {
   "start": 30.95,
   "end": 32.51,
   "text": "Dolar endeksi 103 civarına"
  },
  {
   "start": 32.51,
   "end": 34.31,
   "text": "çıkarak yaklaşık 19 ayın"
  },
  {
   "start": 34.31,
   "end": 36.11,
   "text": "en yüksek seviyesine geldi."
  },
  {
   "start": 36.11,
