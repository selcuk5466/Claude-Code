  {
   "start": 0.2,
   "end": 1.61,
   "text": "Salı günkü enflasyon verisinin"
  },
  {
   "start": 1.61,
   "end": 2.99,
   "text": "ardından Fed yetkilileri dün"
  },
  {
   "start": 2.99,
   "end": 4.085,
   "text": "de aynı mesajı verdi."
  },
  {
   "start": 4.085,
   "end": 5.78,
   "text": "Cleveland Fed Başkanı Hammack,"
  },
  {
   "start": 5.78,
   "end": 8.18,
   "text": "enflasyondaki iyileşmenin durduğunu söyledi"
  },
  {
   "start": 8.18,
   "end": 9.35,
   "text": "ve daha sıkı bir"
  },
  {
   "start": 9.35,
   "end": 10.94,
   "text": "politika gerektiğini belirtti."
  },
  {
   "start": 10.94,
   "end": 12.172,
   "text": "Chicago Fed Başkanı Goolsbee"
  },
  {
   "start": 12.172,
   "end": 13.4,
   "text": "ile San Francisco Fed"
  },
  {
   "start": 13.4,
   "end": 15.14,
   "text": "Başkanı Daly de faizlerin"
  },
  {
   "start": 15.14,
   "end": 16.818,
   "text": "biraz daha artırılması gerekeceğini"
  },
  {
   "start": 16.818,
   "end": 17.6,
   "text": "söyledi."
  },
  {
   "start": 17.6,
   "end": 19.04,
   "text": "Piyasa artık 8–9 Aralık"
  },
  {
   "start": 19.04,
   "end": 20.781,
   "text": "toplantısında çeyrek puanlık artışı"
  },
  {
   "start": 20.781,
   "end": 22.28,
   "text": "%100 fiyatlıyor."
  },
  {
   "start": 22.28,
   "end": 23.787,
   "text": "Yarım puanlık artış ihtimali"
  },
  {
   "start": 23.787,
   "end": 26.09,
   "text": "ise %15 civarında."
  },
  {
   "start": 26.09,
   "end": 27.32,
   "text": "ABD 10 yıllık tahvil"
